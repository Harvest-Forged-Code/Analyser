{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/sensitive-file-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/prompt-injection-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/large-file-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dependency-guard.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-lint.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pylint-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/frontend-lint.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/type-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/test-gate.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-security.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-reminder.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/docstring-check.sh"
          }
        ]
      }
    ]
  }
}
