{
  "enabledMcpjsonServers": [
    "gitkraken",
    "sqlite"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__gitkraken__git_add_or_commit|mcp__github__push_files|mcp__github__create_or_update_file",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-commit-security.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
